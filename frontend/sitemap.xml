        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url>
    <loc>https://rashisharma-portfolio.vercel.app/</loc>
    <lastmod>2026-10-14</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <image:image>
      <image:loc>https://rashisharma-portfolio.vercel.app/images/rashi-sharma-web-developer-digital-marketer.webp</image:loc>
      <image:title>Rashi Sharma, web developer and digital marketing specialist</image:title>
      <image:caption>Portrait of Rashi Sharma, web developer and digital marketing specialist in Pundri, Kaithal, Haryana</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://rashisharma-portfolio.vercel.app/images/og-cover-rashi-sharma.jpg</image:loc>
      <image:title>Rashi Sharma - web developer and digital marketer</image:title>
      <image:caption>Rashi Sharma, web developer and digital marketing specialist from Pundri, Haryana</image:caption>
    </image:image>
  </url>
